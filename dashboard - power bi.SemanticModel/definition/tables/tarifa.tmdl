	partition tarifa = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents("C:\\Users\\ruizd\\Pictures\\BI\\datos finales\\tarifa.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Nombres = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Limpios = Table.ReplaceValue(Nombres, "", null, Replacer.ReplaceValue, {"precio_compartido", "precio_propiedad_cliente", "precio_punta", "precio_fuera_punta"}),
				    Tipos = Table.TransformColumnTypes(Limpios, {{"anio", Int64.Type}, {"mes", Int64.Type}, {"tipo_informacion", type text}, {"tipo_tarifa", type text}, {"tipo_dato", type text}, {"rango_consumo", type text}, {"nivel", type text}, {"precio_propiedad_epm", type number}, {"precio_compartido", type number}, {"precio_propiedad_cliente", type number}, {"precio_punta", type number}, {"precio_fuera_punta", type number}})
				in
				    Tipos

