	partition geografia = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents("C:\\Users\\ruizd\\Pictures\\BI\\datos finales\\geografia.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Nombres = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Tipos = Table.TransformColumnTypes(Nombres, {{"cod_divipola", type text}, {"nombre", type text}, {"departamento", type text}, {"tipo_municipio", type text}, {"latitud", type number}, {"longitud", type number}})
				in
				    Tipos

