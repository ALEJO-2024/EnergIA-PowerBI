table consumo
	lineageTag: 557fab63-5c2e-46ff-94ec-844c8450d6b7

	measure 'kWh medidos' = SUM(consumo[consumo_kwh])
		formatString: #,0.0
		lineageTag: d1d52437-0985-4b13-a8cb-b5c5c6e59a2f

	measure 'kWh promedio' = AVERAGE(consumo[consumo_kwh])
		formatString: #,0.00
		lineageTag: e6dbd712-194b-4035-9ae7-22c7e88ce7fa

	column cliente_id
		dataType: string
		lineageTag: 231135b8-5889-4695-9cf8-75a0ca2e5530
		summarizeBy: none
		sourceColumn: cliente_id

	column fecha_hora
		dataType: dateTime
		lineageTag: a59cd324-6ed2-47e6-aafe-2fddb6ec7fe8
		summarizeBy: none
		sourceColumn: fecha_hora

	column consumo_kwh
		dataType: double
		formatString: #,0.0000
		lineageTag: f2d4d50c-1857-4ceb-a16b-da740d2ace1b
		summarizeBy: sum
		sourceColumn: consumo_kwh

	partition consumo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents("C:\\Users\\ruizd\\Pictures\\BI\\datos finales\\consumo.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Nombres = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Tipos = Table.TransformColumnTypes(Nombres, {{"cliente_id", type text}, {"fecha_hora", type datetime}, {"consumo_kwh", type number}})
				in
				    Tipos

