	partition sui = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents("C:\\Users\\ruizd\\Pictures\\BI\\datos finales\\sui.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Nombres = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Limpios = Table.ReplaceValue(Nombres, "", null, Replacer.ReplaceValue, {"estrato_1", "estrato_2", "estrato_3", "estrato_4", "estrato_5", "estrato_6", "industrial", "comercial", "oficial", "otros"}),
				    Tipos = Table.TransformColumnTypes(Limpios, {{"cod_divipola", type text}, {"anio", Int64.Type}, {"periodo", Int64.Type}, {"ubicacion", type text}, {"empresa", type text}, {"estrato_1", Int64.Type}, {"estrato_2", Int64.Type}, {"estrato_3", Int64.Type}, {"estrato_4", Int64.Type}, {"estrato_5", Int64.Type}, {"estrato_6", Int64.Type}, {"total_residencial", Int64.Type}, {"industrial", Int64.Type}, {"comercial", Int64.Type}, {"oficial", Int64.Type}, {"otros", Int64.Type}, {"total_no_residencial", Int64.Type}})
				in
				    Tipos

