	partition cliente = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents("C:\\Users\\ruizd\\Pictures\\BI\\datos finales\\cliente.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Nombres = Table.TransformColumnNames(Encabezados, each Text.Replace(_, Character.FromNumber(65279), "")),
				    Limpios = Table.ReplaceValue(Nombres, "", null, Replacer.ReplaceValue, {"estrato"}),
				    Tipos = Table.TransformColumnTypes(Limpios, {{"cliente_id", type text}, {"cod_divipola", type text}, {"tipo_cliente", type text}, {"estrato", Int64.Type}, {"estado", type text}})
				in
				    Tipos

